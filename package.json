{
  "name": "sustained-life",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "server",
    "admin"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:server": "npm run dev --workspace=server",
    "dev:admin": "npm run dev --workspace=admin",
    "build": "npm run build --workspace=server && npm run build --workspace=frontend && npm run build --workspace=admin",
    "build:frontend": "npm run build --workspace=frontend",
    "build:server": "npm run build --workspace=server",
    "build:admin": "npm run build --workspace=admin",
    "start:frontend": "npm run start --workspace=frontend",
    "start:server": "npm run start --workspace=server",
    "start:admin": "npm run start --workspace=admin"
  }
}
